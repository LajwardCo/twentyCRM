      "key": "header",
      "bodyHtml": "<header class=\"tpl-header\" style=\"display:flex;align-items:center;gap:12px;border-bottom:1px solid #d8dee9;padding-bottom:8px;margin-bottom:10px;\">\n  {{#if clinic.logo}}<img src=\"{{clinic.logo}}\" alt=\"logo\" style=\"height:48px;width:auto;object-fit:contain;\" />{{/if}}\n  {{#if company.logo}}<img src=\"{{company.logo}}\" alt=\"logo\" style=\"height:48px;width:auto;object-fit:contain;\" />{{/if}}\n  <div style=\"flex:1;\">\n    <div style=\"font-size:16px;font-weight:700;color:#0B253F;\">{{#if clinic.name}}{{clinic.name}}{{else}}{{company.name}}{{/if}}</div>\n    <div style=\"font-size:11px;color:#5b6b7b;\">{{#if clinic.address}}{{clinic.address}}{{else}}{{company.address}}{{/if}}{{#if clinic.phone}} · {{clinic.phone}}{{/if}}{{#if company.phone}} · {{company.phone}}{{/if}}</div>\n  </div>\n</header>"
    },
